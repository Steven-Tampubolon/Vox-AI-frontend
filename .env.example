# Backend AI service
BACKEND_HOST=localhost
BACKEND_PORT=8080

# API key untuk backend (di-inject Nginx BFF, tidak masuk bundle JS)
API_KEY=your-api-key-here

# Vite build config (opsional — default: /api/v1)
# VITE_API_BASE_URL=/api/v1

# Preview mode tanpa backend (development only)
# VITE_PREVIEW_MODE=false